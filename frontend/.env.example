# RingoStrike frontend environment example
#
# Copy this file to:
#   frontend/.env
#
# API base:
# - Use /api-proxy for the current VPS same-origin Nginx deployment.
# - Leave unset only when frontend and backend routes can safely share root paths.
# - Set in local development when the backend runs on a different origin.
# - Loopback values are ignored in production builds and fall back to same-origin.
# VITE_API_BASE=http://localhost:5005

# Frontend base path.
# Use "/" when the app is served from the domain root.
VITE_BASE=/

# Production examples:
#
# Current VPS same-origin deployment:
# VITE_API_BASE=/api-proxy
# VITE_BASE=/
#
# If API is served from a subdomain:
# VITE_API_BASE=https://api.ringostrike.com
# VITE_BASE=/
#
# If frontend is served from a subpath like https://www.ringostrike.com/ringostrike/:
# VITE_API_BASE=https://www.ringostrike.com
# VITE_BASE=/ringostrike/
