# RingoStrike backend environment example
#
# Copy this file to:
#   backend/.env
#
# Never commit real secrets.

# Flask
FLASK_ENV=development
SECRET_KEY=change_me_super_secret

# JWT / Auth
JWT_SECRET=change_me_jwt_secret
JWT_COOKIE_NAME=ringo_token

# Local development:
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
LOCAL_LOGIN_ENABLED=True

# Production example:
# JWT_COOKIE_SECURE=1
# JWT_COOKIE_SAMESITE=Lax
# LOCAL_LOGIN_ENABLED=False

# Database
DB_PATH=ringostrike.db

# Public URLs
PUBLIC_BASE_URL=http://localhost:5005
FRONTEND_BASE_URL=http://localhost:5173

# Production examples:
# PUBLIC_BASE_URL=https://api.ringostrike.com
# FRONTEND_BASE_URL=https://www.ringostrike.com

# Optional CORS/frontend origin alias
# Keep this aligned with FRONTEND_BASE_URL if the backend uses it.
FRONTEND_ORIGIN=http://localhost:5173

# Optional comma-separated CORS allowlist for production/multi-origin deployments.
# Example: CORS_ORIGINS=http://82.115.24.10,https://www.ringostrike.com
CORS_ORIGINS=

# Telegram integration
TELEGRAM_BOT_USERNAME=ringo_strike_bot
TELEGRAM_TEST_CHAT_ID=your_test_chat_id_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
REMINDER_ADMIN_TOKEN=change_me_for_cron_and_bot_bridge

# Notion integration legacy/future support
NOTION_TOKEN=your_notion_token_here
NOTION_USERS_DB_ID=your_db_id_here
NOTION_ENROLLMENTS_DB_ID=your_db_id_here
NOTION_CHALLENGES_DB_ID=your_db_id_here
NOTION_DAILY_LOGS_DB_ID=your_db_id_here
NOTION_TELEGRAM_PROP=Telegram ID

#flask
FLASK_ENV=development
FLASK_HOST=0.0.0.0
PORT=5005
FLASK_DEBUG=1