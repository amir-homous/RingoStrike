    {
      "parameters": {
        "jsCode": "// فرض می‌کنیم ساختار ورودی مثل آپدیت تلگرامه:\nconst item = $input.item.json;\n\nconst text = (item.text || \"\").trim();\n\n// مثال: \"/join READ30\"\nconst parts = text.split(/\\s+/);\n\nif (parts[0] !== \"/join\" || parts.length < 2) {\n  // اگر کد همراهش نبود، یه فلگ خطا می‌ذاریم\n  return [{\n    json: {\n      error: \"NO_JOIN_CODE\",\n      rawText: text,\n    }\n  }];\n}\n\nconst joinCode = parts[1].trim();\n\n// اینجا بسته به ساختار واقعی JSON تلگرام، adjust کن\nconst telegramId   = $input.first().json.chat_id ?? item.from?.id;\nconst firstName    = $input.first().json.first_name || \"\";\nconst lastName     = $input.first().json.last_name || \"\";\nconst username     = \"@\"+$input.first().json.username || \"\";\n\nreturn [{\n  json: {\n    joinCode,\n    telegramId,\n    firstName,\n    lastName,\n    username,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -16
      ],
      "id": "e785504c-42e0-4703-a9e9-016f7d120f8c",
      "name": "Code in JavaScript"
    },
